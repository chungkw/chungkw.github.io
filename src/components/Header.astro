---
import NavItem from "./NavItem.astro";

import IconList from "bootstrap-icons/icons/list.svg";
import IconPersonCircle from "bootstrap-icons/icons/person-circle.svg";
import IconBraces from "bootstrap-icons/icons/braces.svg";
import IconBookmark from "bootstrap-icons/icons/bookmark.svg";

interface Props {
    headerTitle?: string;
}

const { headerTitle = "Kin Wai" } = Astro.props;
---

<header class="container py-3 sticky-top">
    <div class="py-2 px-3 border rounded rounded-3 shadow-sm bg-white">
        <div class="row align-items-center">
            <div class="col flex-grow-1">
                <span class="fw-bold">{headerTitle}</span>
            </div>

            <div class="col-auto d-block d-md-none">
                <button
                    class="btn btn-dark d-flex justify-content-center align-items-center"
                    style="min-height: 36px;"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navigation"
                    aria-expanded="false"
                    aria-label="Navigation"
                    aria-controls="navigation"
                >
                    <IconList />
                </button>
            </div>

            <nav id="navigation" class="col-12 col-md-auto collapse d-md-block">
                <div class="mt-1 m-md-0">
                    <ul class="nav">
                        <NavItem href="/">
                            <IconPersonCircle />
                            About
                        </NavItem>
                        <NavItem href="/projects">
                            <IconBraces />
                            Projects
                        </NavItem>
                        <NavItem href="/blog">
                            <IconBookmark />
                            Blog
                        </NavItem>
                    </ul>
                </div>
            </nav>
        </div>
    </div>
</header>

<script src="../scripts/initCollapse"></script>
