---
import BaseLayout from "../layouts/BaseLayout.astro";

import Header from "../components/Header.astro";
import Popover from "../components/Popover.astro";
import ContactAnchor from "../components/ContactAnchor.astro";

import { contacts } from "../content/contacts";
---

<BaseLayout title="Hello World">
    <div class="d-flex flex-column vh-100">
        <Header />

        <main class="flex-grow-1 container">
            <div class="d-flex align-items-center w-100 h-100">
                <div class="flex-fill p-3 border rounded rounded-3">
                    <h1>
                        <Popover
                            text="Hello world!"
                            popupText="Common phrase present in computer programs, displayed when a program is run."
                        />
                    </h1>

                    <h1>
                        My name is <Popover
                            text="Kin Wai"
                            popupText="My full name is Chung Kin Wai."
                        />.
                    </h1>

                    <h2>
                        I like to <Popover
                            text="write code"
                            popupText="Organic, free-range, hand-written code is what I like to write."
                        /> to <Popover
                            text="solve problems"
                            popupText="Such as cracking an egg."
                        />.
                    </h2>

                    <h2 id="uses">I use JavaScript.</h2>

                    <hr />

                    <div class="d-flex gap-2 text-nowrap flex-wrap">
                        {
                            contacts.map((contact) => (
                                <ContactAnchor {...contact} />
                            ))
                        }
                    </div>
                </div>
            </div>
        </main>
    </div>
</BaseLayout>

<style>
    .vh-100 {
        min-height: 100dvh;
    }
</style>

<script>
    const technologies = [
        "JavaScript",
        "Python",
        "Rust",
        "C#",
        "SQL",
        "HTML",
        "CSS",
        "React",
        "Astro",
        "NodeJS",
    ];

    function sleep(ms: number) {
        return new Promise<void>((resolve) => {
            setTimeout(() => resolve(), ms);
        });
    }

    const element = document.querySelector("#uses");

    let i = 0;

    while (true) {
        if (i >= technologies.length) {
            i = 0;
        }

        const tech = technologies[i];

        if (element) {
            element.textContent = `I use ${tech}.`;
        }

        i += 1;

        await sleep(1500);
    }
</script>
