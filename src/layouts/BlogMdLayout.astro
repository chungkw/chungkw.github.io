---
import BaseLayout from "./BaseLayout.astro";

import Header from "../components/Header.astro";

import { contacts } from "../content/contacts";

import type { CollectionEntry } from "astro:content";

type Props = CollectionEntry<"blog">["data"];

const { title } = Astro.props;
---

<BaseLayout title={title}>
    <Header />

    <main class="container">
        <div class="d-flex justify-content-center">
            <article class="reading-width">
                <slot />
            </article>
        </div>
    </main>

    <footer class="container py-3">
        <div class="p-3 border rounded rounded-3 bg-white text-center">
            <p>Written by Kin Wai</p>

            <div
                class="d-flex gap-3 text-nowrap flex-wrap justify-content-center"
            >
                {
                    contacts.map(({ name, icon, link }) => (
                        <a href={link} class="text-reset text-decoration-none">
                            <i class={`bi ${icon}`} /> {name}
                        </a>
                    ))
                }
            </div>
        </div>
    </footer>
</BaseLayout>

<style>
    .reading-width {
        max-width: 80ch;
    }

    :global(img) {
        display: block;
        margin: auto;
        max-width: 100%;
        max-height: 75ch;
        width: auto;
        height: auto;
    }

    :global(article > :last-child) {
        margin-bottom: 0;
    }
</style>
