---
interface Props {
    popupText: string;
    highlighter?: boolean;
}

const { popupText, highlighter = false } = Astro.props;
---

<a
    class:list={[
        "text-reset text-decoration-none text-nowrap",
        { "bg-warning bg-opacity-50": highlighter },
    ]}
    role="button"
    tabindex="0"
    data-bs-container="body"
    data-bs-toggle="popover"
    data-bs-placement="bottom"
    data-bs-content={popupText}
>
    <slot />
</a>

<style is:global>
    .popover-body {
        font-family: var(--font-inter);
    }
</style>
