---
interface Props {
    popupText: string;
}

const { popupText } = Astro.props;
---

<style>
    .ws-nowrap {
        white-space: nowrap;
    }

    :global(.popover-body) {
        font-family: var(--font-inter);
        font-optical-sizing: auto;
    }
</style>

<a
    class="text-reset text-decoration-none ws-nowrap bg-warning bg-opacity-50"
    role="button"
    tabindex="0"
    data-bs-container="body"
    data-bs-toggle="popover"
    data-bs-placement="bottom"
    data-bs-content={popupText}
>
    <slot />
</a>
