---
const { title, icon, description, links } = Astro.props;
---

<div class="border mt-3 p-3">
    <div class="row">
        <div class="col">
            <h3><i class={`bi ${icon}`}></i>&nbsp;{title}</h3>
        </div>

        <div class="col-lg-8">
            <p>{description}</p>

            <div class="d-flex gap-2 text-nowrap overflow-auto w-100">
                {
                    links.map(({ url = "", label = "" }) => (
                        <a
                            href={url}
                            class="btn btn-primary"
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            {label}
                        </a>
                    ))
                }
            </div>
        </div>
    </div>
</div>
