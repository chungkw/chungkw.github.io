---
import BaseLayout from "./BaseLayout.astro";

import Header from "../components/Header.astro";

import { contacts } from "../content/contacts";

import type { CollectionEntry } from "astro:content";

type Props = CollectionEntry<"blog">["data"];

const { title, blurb } = Astro.props;
---

<BaseLayout title={title}>
    <Header headerTitle={blurb} />

    <main class="container">
        <div class="d-flex justify-content-center">
            <article class="reading-width">
                <slot />
            </article>
        </div>
    </main>

    <footer class="container py-3">
        <div
            class="px-3 py-2 border rounded rounded-3 bg-dark text-light text-center"
        >
            <div class="row">
                <div
                    class="col-12 col-md-auto flex-grow-1 my-1 text-center text-md-start"
                >
                    Written by <span class="text-nowrap">Kin Wai</span>
                </div>

                {
                    contacts.map(({ name, icon, link }) => (
                        <div class="col-6 col-sm-4 col-md-auto flex-grow-1 flex-md-grow-0 my-1 text-center">
                            <a
                                href={link}
                                class="text-reset text-decoration-none"
                            >
                                <span class="me-1">
                                    <i class={`bi ${icon}`} />
                                </span>
                                {name}
                            </a>
                        </div>
                    ))
                }
            </div>
        </div>
    </footer>
</BaseLayout>

<style>
    .reading-width {
        max-width: 80ch;
    }
</style>

<style is:global>
    img {
        display: block;
        margin: auto;
        max-width: 100%;
        max-height: 75ch;
        width: auto;
        height: auto;
    }

    article > :last-child {
        margin-bottom: 0;
    }
</style>
