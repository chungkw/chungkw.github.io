---
interface Props {
    href: string;
    text: string;
    icon: string;
}

const { href, text, icon } = Astro.props;

// From the Astro blog template
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, "");
const subpath = pathname.match(/[^\/]+/g);

const isActive = href === pathname || href === "/" + (subpath?.[0] || "");
---

<li
    class:list={[
        "nav-item flex-basis-third flex-md-basis-auto text-center",
        { "border-bottom border-2 border-dark": isActive },
    ]}
>
    <a
        class="nav-link text-reset p-2"
        href={href}
        aria-current={isActive ? "page" : undefined}
    >
        <span class="d-none d-ss-inline me-1"><i class={`bi ${icon}`}></i></span
        >
        <span class:list={["", { "fw-bold": isActive }]}>{text}</span>
    </a>
</li>

<style>
    .flex-basis-third {
        flex-basis: calc(100% / 3);
    }

    @media (min-width: 768px) {
        .flex-md-basis-auto {
            flex-basis: auto;
        }
    }

    /* ss in between xs and sm */
    @media (min-width: 370px) {
        .d-ss-inline {
            display: inline !important;
        }
    }
</style>
