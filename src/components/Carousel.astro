---
import CarouselCard from "./CarouselCard.astro";

const projects = [
    {
        title: "Discord Bot",
        icon: "bi-discord",
        description:
            "A project primarily for fun. It is also a really good way to learn and experiment, with visual interactivity. Made with JavaScript.",
        links: [
            {
                url: "https://github.com/chungkw/discord-bot",
                label: "GitHub Repo",
            },
        ],
    },
    {
        title: "Duty Planner",
        icon: "bi-calendar-check",
        description:
            "Simple program to draw a planner for duty planning. Planner is drawn in Excel to visualize data. Made with Python.",
        links: [
            {
                url: "https://github.com/chungkw/duty-planner-gui",
                label: "GitHub Repo",
            },
        ],
    },
    {
        title: "Sequelize ORM Tutorial",
        icon: "bi-book",
        description:
            "A tutorial on using Sequelize, an object-relational mapping tool in JavaScript, for NodeJS-powered backend. Written during my time in Polytechnic, shared with my classmates.",
        links: [
            {
                url: "https://github.com/chungkw/sequelize_tutorial",
                label: "GitHub Repo",
            },
        ],
    },
    {
        title: "This Website",
        icon: "bi-globe2",
        description:
            "A website to present myself and my projects. Uses GitHub Actions to automate deployment. Made with Astro.",
        links: [
            {
                url: "https://github.com/chungkw/chungkw.github.io",
                label: "GitHub Repo",
            },
        ],
    },
];
---

<div id="carouselProjects" class="carousel slide mb-3" data-bs-ride="carousel">
    <div class="carousel-inner">
        {
            projects.map((project, i) => (
                <div
                    class={`carousel-item ${i === 0 ? "active" : ""}`}
                    data-bs-interval="4000"
                >
                    <CarouselCard {...project} />
                </div>
            ))
        }
    </div>
</div>

<div class="d-flex justify-content-end gap-2">
    <button
        type="button"
        class="btn btn btn-dark"
        data-bs-target="#carouselProjects"
        data-bs-slide="prev"
    >
        <i class="bi bi-caret-left-fill"></i>
    </button>

    <button
        type="button"
        class="btn btn btn-dark"
        data-bs-target="#carouselProjects"
        data-bs-slide="next"
    >
        <i class="bi bi-caret-right-fill"></i>
    </button>
</div>
