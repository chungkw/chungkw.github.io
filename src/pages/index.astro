---
import Carousel from "../components/Carousel.astro";
---

<html lang="en">
    <head>
        <meta charset="utf-8" />

        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />

        <!-- Bootstrap CSS -->
        <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
            rel="stylesheet"
            integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
            crossorigin="anonymous"
        />

        <!-- Bootstrap Icons -->
        <link
            rel="stylesheet"
            href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css"
        />

        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />

        <title>Hello World</title>
    </head>

    <body>
        <!-- Bootstrap JS -->
        <script
            src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
            crossorigin="anonymous"></script>

        <div class="centre">
            <div class="container py-4">
                <h1>Hello world!</h1>
                <h1>My name is Kin Wai.</h1>

                <h2 class="mt-4">I like to write code to solve problems.</h2>
                <h2 id="uses">I use JavaScript.</h2>

                <Carousel />
            </div>
        </div>
    </body>

    <style>
        .centre {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100dvh;
        }
    </style>

    <script is:inline async type="module">
        const technologies = [
            "JavaScript",
            "Python",
            "Rust",
            "C#",
            "SQL",
            "HTML",
            "CSS",
            "React",
            "Astro",
            "NodeJS",
        ];

        async function sleep(ms) {
            return new Promise((resolve) => {
                setTimeout(() => resolve(), ms);
            });
        }

        const element = document.querySelector("#uses");

        let i = 0;

        while (true) {
            if (i >= technologies.length) {
                i = 0;
            }

            const tech = technologies[i];

            if (element) {
                element.textContent = `I use ${tech}.`;
            }

            i += 1;

            await sleep(1500);
        }
    </script>
</html>
