---
import BaseLayout from "../layouts/BaseLayout.astro";

import PopoverText from "../components/PopoverText.astro";
import ContactAnchor from "../components/ContactAnchor.astro";
import ProjectFeature from "../components/ProjectFeature.astro";

import { contacts } from "../content/contacts";
import { projects } from "../content/projects";
---

<BaseLayout title="Hello World">
    <main class="container my-4">
        <h1>
            <PopoverText
                text="Hello world!"
                popupText="Common phrase present in computer programs, displayed when a program is run."
            />
        </h1>

        <h1>
            My name is <PopoverText
                text="Kin Wai"
                popupText="My full name is Chung Kin Wai."
            />.
        </h1>

        <h2>
            I like to <PopoverText
                text="write code"
                popupText="Organic, free-range, hand-written code is what I like to write."
            /> to <PopoverText
                text="solve problems"
                popupText="Such as cracking an egg."
            />.
        </h2>

        <h2 id="uses">I use JavaScript.</h2>

        <hr />

        <div class="d-flex gap-2 text-nowrap overflow-auto w-100">
            {contacts.map((contact) => <ContactAnchor {...contact} />)}
        </div>

        <hr />

        <h3>My Projects</h3>

        {projects.map((project) => <ProjectFeature {...project} />)}
    </main>
</BaseLayout>

<script>
    const technologies = [
        "JavaScript",
        "Python",
        "Rust",
        "C#",
        "SQL",
        "HTML",
        "CSS",
        "React",
        "Astro",
        "NodeJS",
    ];

    function sleep(ms: number) {
        return new Promise<void>((resolve) => {
            setTimeout(() => resolve(), ms);
        });
    }

    const element = document.querySelector("#uses");

    let i = 0;

    while (true) {
        if (i >= technologies.length) {
            i = 0;
        }

        const tech = technologies[i];

        if (element) {
            element.textContent = `I use ${tech}.`;
        }

        i += 1;

        await sleep(1500);
    }
</script>
