---
const { title, icon, description, technologies, links } = Astro.props;
---

<div class="border mt-3 p-3">
    <div class="row">
        <div class="col">
            <h3><i class={`bi ${icon}`}></i>&nbsp;{title}</h3>
        </div>

        <div class="col-md-7 col-lg-8">
            <p class="mb-2">{description}</p>

            <div class="d-flex flex-wrap gap-2 mb-2 text-nowrap">
                {
                    technologies.map((tech = "") => (
                        <p class="m-0">
                            <span class="badge rounded-pill text-bg-dark font-monospace">
                                {tech}
                            </span>
                        </p>
                    ))
                }
            </div>

            <div class="d-flex gap-2 text-nowrap overflow-auto w-100">
                {
                    links.map(({ url = "", label = "" }) => (
                        <a
                            href={url}
                            class="btn btn-primary"
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            {label}
                        </a>
                    ))
                }
            </div>
        </div>
    </div>
</div>
