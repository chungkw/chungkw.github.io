---
import type { CollectionEntry } from "astro:content";

type Props = CollectionEntry<"blog">["data"];

const { title, description, createdAt } = Astro.props;

let displayDate = new Date(createdAt).toLocaleDateString("en-SG");
---

<div class="mb-3 p-3 border rounded rounded-3 bg-white">
    <h3 class="mb-2">{title}</h3>

    <p class="mb-2">{displayDate}</p>

    <p class="m-0"><span class="fst-italic">{description}</span></p>
</div>
